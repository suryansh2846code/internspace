# ────────────────────────────────────────────────────────────
# InternSpace — Environment Variables
# Copy to .env and fill in your values. Never commit .env!
# ────────────────────────────────────────────────────────────

# ── Server (Brain) ──────────────────────────────────────────

# Database: SQLite locally, PostgreSQL in production (Azure / Railway).
# Azure example: postgresql://<user>:<password>@<host>:5432/<db>?sslmode=require
DATABASE_URL=sqlite:///./data/app.db

# JWT secret — MUST be a strong random string in production.
# Generate one: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-secret-change-me

# LLM provider for keyword extraction & answer generation.
# Options: groq | openai | anthropic
LLM_PROVIDER=groq

# API keys — only the one matching LLM_PROVIDER is required.
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# CORS: comma-separated allowed origins. Leave empty when the frontend
# is served by the same FastAPI server (default, same-origin).
# Example: https://my-app.azurecontainerapps.io
ALLOWED_ORIGINS=

# Download URLs for the packaged agent apps (empty → terminal fallback).
AGENT_DOWNLOAD_MAC=
AGENT_DOWNLOAD_WINDOWS=

# ── Agent (Local, on user's machine) ───────────────────────

# Server URL the agent polls. Set to the Azure Container App URL in production.
# SERVER_URL=https://<your-app>.<region>.azurecontainerapps.io

# Pairing token from the web dashboard's "Connect your computer" wizard.
# AGENT_PAIR_TOKEN=

# ── Legacy / CLI agent (optional) ──────────────────────────

# Internshala credentials (only used by the legacy CLI, not the Path-B agent).
# INTERNSHALA_EMAIL=
# INTERNSHALA_PASSWORD=

# Applicant details for platforms that require them per application.
# USER_LOCATION=Faridabad
# USER_COURSE_DURATION=4
